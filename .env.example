# Supabase: copy the Transaction pooler URI from Connect (port 6543).
# This server-only override takes priority over managed Neon environment variables.
SUPABASE_DATABASE_URL=
# Optional CA certificate from Supabase Database Settings (PEM; literal \n allowed).
DATABASE_CA_CERT=
# Block this app's database access during the final data transfer.
# Set to 1 before export; remove only after verified Supabase cutover.
STATUS_DATABASE_MIGRATION_PAUSED=

# Existing Neon connection string, or another PostgreSQL connection string.
# Keep this unchanged until the Supabase import has been verified.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Copy the existing values from the private local .dev.vars file into Vercel's
# Environment Variables. Never commit the real values.
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional Discord webhook for one-time incident, maintenance, and recovery alerts.
# Create a fresh webhook and store its URL only in local .dev.vars or Vercel Environment Variables.
DISCORD_WEBHOOK_URL=

# Shared secret: set the same random value in Vercel and on the always-on monitor host.
MONITOR_SECRET=
# Used only by monitor/worker.mjs on the always-on host.
STATUS_API_URL=https://status.example.com
